# Ellery AI — environment variables (all optional for local dev)

# Port the server listens on (default 4173)
PORT=4173

# Enables secure cookies; set to "production" when served over HTTPS.
# NODE_ENV=production

# Stable session signing secret. If unset, a random per-boot secret is used
# (fine for local dev; set a stable value in production so sessions survive
# restarts). Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# SESSION_SECRET=
